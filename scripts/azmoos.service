[Unit]
Description=Azmo OS — serveur personnel (Made by Azmo)
Documentation=https://github.com/azmoweb/azmoos
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/azmod -addr :80 -data /DATA -config /etc/azmoos -web /usr/share/azmoos/web
Restart=always
RestartSec=3
# Le démon gère disques, réseau et Docker : il doit tourner en root.
# On limite tout de même ce qui n'est pas nécessaire.
ProtectHome=read-only
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
